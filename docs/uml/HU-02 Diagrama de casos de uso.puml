@startuml
title HU-02 - Agregar productos al carrito - Diagrama de Casos de Uso

left to right direction

actor "Cliente" as Cliente

rectangle "Sistema TechStore" {

    usecase "Agregar producto\nal carrito" as UC1
    usecase "Seleccionar cantidad" as UC2
    usecase "Validar disponibilidad" as UC3
    usecase "Consultar carrito" as UC4
    usecase "Modificar cantidad" as UC5
    usecase "Eliminar producto\ndel carrito" as UC6
    usecase "Calcular subtotal" as UC7
    usecase "Calcular total" as UC8
    usecase "Mostrar producto\nagotado" as UC9
    usecase "Mostrar error de\nstock insuficiente" as UC10
}

Cliente --> UC1
Cliente --> UC4
Cliente --> UC5
Cliente --> UC6

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC7 : <<include>>

UC4 ..> UC8 : <<include>>
UC5 ..> UC7 : <<include>>
UC5 ..> UC8 : <<include>>
UC6 ..> UC8 : <<include>>

UC9 ..> UC3 : <<extend>>
UC10 ..> UC3 : <<extend>>

@enduml